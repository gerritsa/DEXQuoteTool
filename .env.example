# Server-side only. Create a local .env file and never expose this value to browser code.
NEAR_INTENTS_API_KEY=

# Chain-specific destination and refund addresses are required before live benchmarking.
BENCHMARK_BTC_ADDRESS=
BENCHMARK_EVM_ADDRESS=
BENCHMARK_TRON_ADDRESS=

# Optional bearer token for an administrator-only manual benchmark request.
# Scheduled collection does not use this endpoint.
COLLECTOR_ADMIN_TOKEN=
