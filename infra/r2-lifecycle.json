{
  "rules": [
    {
      "id": "expire-volume-repair-data",
      "enabled": true,
      "conditions": { "prefix": "volume/" },
      "deleteObjectsTransition": { "condition": { "type": "Age", "maxAge": 604800 } }
    },
    {
      "id": "expire-raw-quote-payloads",
      "enabled": true,
      "conditions": {
        "prefix": "raw/"
      },
      "deleteObjectsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 604800
        }
      }
    },
    {
      "id": "expire-normalized-quote-archives",
      "enabled": true,
      "conditions": {
        "prefix": "normalized/"
      },
      "deleteObjectsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 172800000
        }
      }
    }
  ]
}
