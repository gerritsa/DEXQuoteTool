{
  "rules": [
    {
      "id": "expire-raw-quote-payloads",
      "enabled": true,
      "prefix": "raw/",
      "expiration": {
        "days": 7
      }
    },
    {
      "id": "expire-normalized-quote-archives",
      "enabled": true,
      "prefix": "normalized/",
      "expiration": {
        "days": 365
      }
    }
  ]
}
